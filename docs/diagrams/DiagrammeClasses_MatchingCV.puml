@startuml DiagrammeClasses_MatchingCV
' ==============================================================================
' Diagramme de Classes - Plateforme Matching CV & Offres
' Optimisé : Hiérarchie Top-to-Bottom, Tracés orthogonaux propres, 0 croisement
' ==============================================================================

top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI", "Helvetica", Arial, sans-serif
skinparam defaultFontSize 12

' --- Palette de couleurs moderne ---
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.3
    ArrowColor #334155
    ArrowThickness 1.2
}

skinparam enum {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontStyle bold
    FontColor #0F172A
}

hide circle

' ==============================================================================
' ÉNUMÉRATIONS DU DOMAINE
' ==============================================================================
package "Énumérations du Domaine" <<Rectangle>> {
  enum Role {
    ETUDIANT
    RECRUTEUR
    ADMIN
  }

  enum StatutOffre {
    ACTIVE
    CLOTUREE
  }

  enum TypeContrat {
    STAGE
    CDI
    CDD
    ALTERNANCE
  }

  enum StatutCandidature {
    ENVOYEE
    VUE
    ACCEPTEE
    REFUSEE
  }

  enum StatutCompetence {
    VALIDEE
    EN_ATTENTE
    REJETEE
  }

  enum Provenance {
    DECLARATIF
    PROJET
    EXPERIENCE
  }

  enum TypeExigence {
    REQUISE
    ATOUT
  }
}

' ==============================================================================
' MODULE UTILISATEURS & AUTHENTIFICATION (NIVEAU 1)
' ==============================================================================
package "Module Utilisateurs & Authentification" <<Rectangle>> {
  abstract class Utilisateur {
    - id : Long
    - nom : String
    - prenom : String
    - email : String
    - motDePasse : String
    - role : Role
    - dateInscription : LocalDateTime
    + prePersist() : void
  }

  class Administrateur {
  }

  class Etudiant {
    - filiere : String
    - etablissement : String
  }

  class Recruteur {
    - nomEntreprise : String
    - secteurActivite : String
  }
}

' ==============================================================================
' MODULE PROFIL ÉTUDIANT (NIVEAU 2 GAUCHE)
' ==============================================================================
package "Module Profil Étudiant" <<Rectangle>> {
  class Projet {
    - id : Long
    - titre : String
    - description : String
  }

  class ExperienceProfessionnelle {
    - id : Long
    - poste : String
    - entreprise : String
    - dateDebut : LocalDate
    - dateFin : LocalDate
  }
}

' ==============================================================================
' MODULE CANDIDATURES & NOTIFICATIONS (NIVEAU 2 CENTRE)
' ==============================================================================
package "Module Candidatures & Notifications" <<Rectangle>> {
  class Candidature {
    - id : Long
    - score : Double
    - statut : StatutCandidature
    - dateCandidature : LocalDateTime
    + prePersist() : void
  }

  class Notification {
    - id : Long
    - score : Double
    - lue : Boolean
    - dateEnvoi : LocalDateTime
    + prePersist() : void
  }
}

' ==============================================================================
' MODULE OFFRES RECRUTEUR (NIVEAU 2 DROITE)
' ==============================================================================
package "Module Offres Recruteur" <<Rectangle>> {
  class Offre {
    - id : Long
    - titre : String
    - description : String
    - domaine : String
    - localisation : String
    - typeContrat : TypeContrat
    - statut : StatutOffre
    - datePublication : LocalDateTime
    + prePersist() : void
  }
}

' ==============================================================================
' MODULE COMPÉTENCES & MATCHING ALGORITHMIQUE (NIVEAU 3)
' ==============================================================================
package "Module Compétences & Matching Algorithmique" <<Rectangle>> {
  class ProfilCompetence {
    - id : Long
    - provenance : Provenance
    - dureeMois : Integer
    - dateAjout : LocalDateTime
  }

  class OffreCompetence {
    - id : Long
    - typeExigence : TypeExigence
  }

  class Competence {
    - id : Long
    - nom : String
    - nomNormalise : String
    - categorie : String
    - statut : StatutCompetence
    - synonymes : List<String>
    + normaliserNom(nom : String) : String
  }
}

' ==============================================================================
' HÉRITAGE UTILISATEUR
' ==============================================================================
Utilisateur <|-- Administrateur
Utilisateur <|-- Etudiant
Utilisateur <|-- Recruteur

' Alignements horizontaux propres pour stabiliser les colonnes
Administrateur -[hidden]right- Etudiant
Etudiant -[hidden]right- Recruteur

Projet -[hidden]down- ExperienceProfessionnelle
Candidature -[hidden]down- Notification

ProfilCompetence -[hidden]right- Competence
Competence -[hidden]right- OffreCompetence

' ==============================================================================
' RELATIONS DOMAINE & INTERACTIONS
' ==============================================================================

' 1. Recruteur -> Offres
Recruteur "1" --down-> "0..*" Offre : "publie >"

' 2. Étudiant -> Profil (Compositions)
Etudiant "1" *--down-> "0..*" Projet : "réalise >"
Etudiant "1" *--down-> "0..*" ExperienceProfessionnelle : "effectue >"

' 3. Candidatures & Notifications (Interactions Étudiant <-> Offre)
Etudiant "1" --down-> "0..*" Candidature : "soumet >"
Offre "1" --down-> "0..*" Candidature : "reçoit >"

Etudiant "1" --down-> "0..*" Notification : "reçoit >"
Offre "1" --down-> "0..*" Notification : "génère >"

' 4. Offre -> Compétences de l'offre (Composition)
Offre "1" *--down-> "1..*" OffreCompetence : "exige >"
OffreCompetence "0..*" --down-> "1" Competence : "cible <"

' 5. Étudiant -> Compétences & Provenances
Etudiant "1" --down-> "0..*" ProfilCompetence : "possède >"
ProfilCompetence "0..*" --down-> "1" Competence : "qualifie <"

' 6. Compétences associées aux Projets et Expériences
Projet "0..*" --down-> "0..*" Competence : "mobilise >"
ExperienceProfessionnelle "0..*" --down-> "0..*" Competence : "applique >"
Etudiant "0..*" --down-> "0..*" Competence : "déclare directement >"

@enduml
